  raw_corpus_path: "{{}}raw_data/dailytalk"
  sub_dir_name: "data"
  lexicon_path: "lexicon/librispeech-lexicon.txt"
  intermediate_data_path: "/home/antonio/Documents/MastersDegree/DailyTalk/raw_data/_dailytalk"
  preprocessed_data_path: "./preprocessed_data/dailytalk"
```

